# SeguroAuto default: local Rehearsal mode
# Rehearsal uses the bundled MCP mock and deterministic demo data. It does not
# call NAI or any external payment system.
DEMO_MODE=rehearsal
APP_PORT=8080
MCP_URL=http://mcp-mock:8001/mcp
MCP_API_KEY=
MCP_PROTOCOL_VERSION=2025-06-18
MOCK_LLM=true
TLS_VERIFY=true

# Live mode: uncomment and configure these values, then set DEMO_MODE=live.
# In Live mode, tool exposure is controlled by the NAI MCP Connector; the
# MOCK_MCP_EXPOSE_PAYOUT setting below has no effect.
# MOCK_LLM=false
# NAI_UNIFIED_ENDPOINT_URL=https://<nai-host>/enterpriseai/gateway/v1
# NAI_UNIFIED_ENDPOINT_NAME=<exact-unified-endpoint-name>
# NAI_API_KEY=<virtual-unified-endpoint-key>
# MCP_URL=https://<nai-host>/enterpriseai/gateway/mcp/<connector>
# MCP_API_KEY=<virtual-mcp-key>

# Insurance MCP tool names
MCP_POLICY_TOOL=get_customer_policy
MCP_CLAIM_TOOL=get_claim_status
MCP_REPAIR_TOOL=find_repair_shops
MCP_CREATE_CLAIM_TOOL=create_claim
MCP_BLOCKED_TOOL=approve_claim_payout

# Payout exposure and application-policy demonstration
#
# The payout flow has three intentionally different outcomes:
#
#   1) Tool is NOT exposed by MCP:
#      The app reports "tool not available through the MCP connector" and does
#      not invoke tools/call. This is the correct result when the Connector
#      does not publish approve_claim_payout.
#
#   2) Tool IS exposed and application policy is OFF:
#      The app invokes approve_claim_payout through MCP. In Rehearsal, the
#      bundled mock returns a deterministic simulated result; no real payment
#      is made. In Live, the call is delegated to the configured MCP Connector.
#
#   3) Tool IS exposed and application policy is ON:
#      The app denies the request locally before invoking MCP. This demonstrates
#      an application-level policy overlay, independent of Connector exposure.
#
# Rehearsal examples:
#   Exposed and usable:       MOCK_MCP_EXPOSE_PAYOUT=true  + APP_POLICY_DENY_PAYOUT=false
#   Not exposed:               MOCK_MCP_EXPOSE_PAYOUT=false + APP_POLICY_DENY_PAYOUT=false
#   App policy denial:         MOCK_MCP_EXPOSE_PAYOUT=true  + APP_POLICY_DENY_PAYOUT=true
#
# Default: expose the tool and allow the app to invoke it.
APP_POLICY_DENY_PAYOUT=false
# Rehearsal only. Set false to simulate an MCP Connector that does not publish
# approve_claim_payout. In Live mode, configure exposure in the NAI Connector.
MOCK_MCP_EXPOSE_PAYOUT=true

# Dedicated Live fallback validation (optional)
ENABLE_LIVE_FALLBACK_TEST=false
NAI_FALLBACK_TEST_URL=https://<nai-host>/enterpriseai/gateway/v1/chat/completions
NAI_FALLBACK_TEST_KEY=<dedicated-test-virtual-api-key>
NAI_FALLBACK_TEST_MODEL=<dedicated-test-unified-endpoint-name>
NAI_FALLBACK_TEST_TLS_VERIFY=true

# Optional isolated fault-provider lab
# Set a local random value before starting compose.fault-lab.yml.
FAULT_ADMIN_TOKEN=<local-random-token>
FAULT_LAB_INFERENCE_BIND=127.0.0.1
FAULT_LAB_INFERENCE_PORT=8090
FAULT_ADMIN_PORT=8089
LLM_MAX_TOKENS=512

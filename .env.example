# Runtime
DEMO_MODE=live
APP_PORT=8080

# NAI Unified Endpoint. Use the full path ending in /v1 when possible.
NAI_UNIFIED_ENDPOINT_URL=https://<nai-host>/enterpriseai/gateway/v1
NAI_API_KEY=<virtual-unified-endpoint-key>

# Model aliases configured in the NAI Unified Endpoint.
NAI_MODEL_OPENAI=<openai-model-alias>
NAI_MODEL_ANTHROPIC=<claude-model-alias>
NAI_MODEL_PRIVATE=<private-nai-model-alias>

# LIVE: URL of the MCP Connector created in NAI 2.7.
# The MCP server itself is deployed in NAI as a Local MCP Server.
MCP_URL=https://<nai-host>/enterpriseai/gateway/mcp/<connector>
MCP_API_KEY=<virtual-mcp-key>

# REHEARSAL ONLY: override the two values above with:
# MCP_URL=http://mcp-mock:8001/mcp
# MCP_API_KEY=

# Insurance MCP tool names
MCP_POLICY_TOOL=get_customer_policy
MCP_CLAIM_TOOL=get_claim_status
MCP_REPAIR_TOOL=find_repair_shops
MCP_CREATE_CLAIM_TOOL=create_claim
MCP_BLOCKED_TOOL=approve_claim_payout

# Set true only to rehearse the UI without live NAI credentials.
MOCK_LLM=false
